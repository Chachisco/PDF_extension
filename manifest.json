{
  "manifest_version": 3,
  "name": "PDF Viewer 2",
  "version": "1.0",
  "description": "Bookmarks, notas e slide lateral para PDFs",
  "permissions": ["storage", "tabs", "activeTab"],
  "action": {
    "default_title": "PDF Viewer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"]
}